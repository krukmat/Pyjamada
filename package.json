{
  "name": "pyjamada",
  "version": "0.9.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "screenshots:android": "bash scripts/android-screenshots.sh",
    "typecheck": "tsc --noEmit",
    "test:game": "rm -rf .test-dist && tsc -p tsconfig.test.json && node .test-dist/tests/game.test.js",
    "test:settings": "rm -rf .test-dist && tsc -p tsconfig.test.json && node .test-dist/tests/settings.test.js",
    "test:presentation": "rm -rf .test-dist && tsc -p tsconfig.test.json && node .test-dist/tests/presentation.test.js",
    "test:all": "rm -rf .test-dist && tsc -p tsconfig.test.json && node .test-dist/tests/game.test.js && node .test-dist/tests/settings.test.js && node .test-dist/tests/presentation.test.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
